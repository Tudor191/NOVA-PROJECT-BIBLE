# The local stack's one-shot schema migrator.
#
# Build context is the repo root:
#   docker build -f infra/docker/Dockerfile.migrations .
#
# Unlike every other Dockerfile here, which each install a single component via
# `uv sync --package <name>`, this installs the whole workspace. That is the
# entire reason it exists: a migrator has to reach all fifteen migrated
# components' `alembic/` trees and their `Settings` classes -- thirteen engines
# plus `agent-os/kernel` and `agent-os/registry` since Phase 4C -- and no
# per-component image can. `--all-packages` already covered the two `agent-os`
# entries before they were migrated here, so 4C.1 needed no change to this
# file's build.
#
# It runs to completion and exits. Nothing depends on it at runtime, it exposes
# no port, and it is not a deployed service -- so it is deliberately not in
# `build-and-scan.yml`'s matrix, which covers images that actually serve
# traffic. That exclusion is now enforced rather than merely stated:
# `tools/tests/test_build_and_scan_matrix.py` requires every Dockerfile in the
# repository to be either in the matrix or in its `UNSCANNED` map with a
# reason, and this file is the map's one entry.

FROM python:3.12-slim
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
RUN useradd --create-home --uid 1000 nova
WORKDIR /app

# The whole workspace, because the migrator needs every engine's alembic tree
# and every engine's `Settings`. `--no-dev` keeps test-only dependencies out;
# `alembic>=1.13` is a main dependency of each engine, so it is present.
COPY --chown=nova:nova . .
RUN uv sync --frozen --no-dev --all-packages

COPY --chown=nova:nova infra/docker/run-migrations.sh /usr/local/bin/run-migrations.sh
RUN chmod +x /usr/local/bin/run-migrations.sh

ENV PATH="/app/.venv/bin:$PATH"
USER nova

ENTRYPOINT ["/usr/local/bin/run-migrations.sh"]

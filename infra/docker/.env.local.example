# Copy to infra/docker/.env.local and adjust if you want credentials other than the
# (deliberately obvious, dev-only) defaults baked into docker-compose.local.yml.
# `docker compose --env-file infra/docker/.env.local -f infra/docker/docker-compose.local.yml up -d`

POSTGRES_USER=nova
POSTGRES_PASSWORD=nova_dev_password
POSTGRES_DB=nova

NEO4J_AUTH=neo4j/nova_dev_password

MINIO_ROOT_USER=nova
MINIO_ROOT_PASSWORD=nova_dev_password

GRAFANA_ADMIN_PASSWORD=nova_dev_password
